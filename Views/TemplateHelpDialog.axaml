<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Inlay.ViewModels"
        x:Class="Inlay.TemplateHelpDialog"
        x:DataType="vm:CloseDialogViewModel"
        Title="Using templates" MinWidth="500"
        SizeToContent="WidthAndHeight"
        Background="{DynamicResource InlayShellBackgroundBrush}"
        CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="14">
    <TextBlock Text="Templates" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Text="Place the caret where you want a choice, then select Insert template."
               MaxWidth="600"
               TextWrapping="Wrap" />
    <TextBlock Text="Click the blue underlined placeholder to add choices or pick the text shown in the document."
               MaxWidth="600"
               TextWrapping="Wrap" />
    <TextBlock Text="The JSON file keeps each choice and its current selection. You can also edit the file outside this app."
               MaxWidth="600"
               TextWrapping="Wrap" />
    <Button Content="Close" MinWidth="80" HorizontalAlignment="Right"
            Command="{Binding CloseCommand}" />
  </StackPanel>
</Window>
