<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Inlay.ViewModels"
        x:Class="Inlay.MessageDialog"
        x:DataType="vm:MessageDialogViewModel"
        Title="{Binding Title}" Width="460" Height="190"
        Background="{DynamicResource InlayShellBackgroundBrush}"
        CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="18">
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    <Button Content="Close" MinWidth="80" HorizontalAlignment="Right"
            Command="{Binding CloseCommand}" />
  </StackPanel>
</Window>
